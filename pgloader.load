LOAD DATABASE
FROM mysql://magical_docker_migrator:321magical123@host.docker.internal:3306/magical
INTO postgresql://postgres:321magical123@host.docker.internal:5432/magical_pg

 WITH create tables,
      create indexes,
      reset sequences,
      foreign keys

 SET work_mem to '64MB',
     maintenance_work_mem to '256MB'

 CAST type datetime to timestamptz,
      type date to date,
      type json to jsonb;